# 이 파일을 복사해서 .env 파일을 만들고 값을 채우세요. (.env는 저장소에 올라가지 않습니다)
# 배포(Vercel)할 때는 Vercel 화면의 Environment Variables에 같은 이름으로 넣습니다.

# Claude API 키 (https://console.anthropic.com 에서 발급). 비워 두면 "체험 모드"로 예시 3안을 보여 줍니다.
ANTHROPIC_API_KEY=
# 사용할 Claude 모델 이름 (비워 두면 claude-opus-5-5)
CLAUDE_MODEL=

# MongoDB Atlas 접속 주소 (mongodb+srv://...). 비워 두면 저장 기능이 꺼집니다.
MONGODB_URI=
# 사용할 데이터베이스 이름
MONGODB_DB=school_autonomy
