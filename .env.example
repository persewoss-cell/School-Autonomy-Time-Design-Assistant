# 이 파일을 복사해서 .env 파일을 만들고 값을 채우세요. (.env는 저장소에 올라가지 않습니다)
# 배포(Vercel)할 때는 Vercel 화면의 Environment Variables에 같은 이름으로 넣습니다.
# AI는 앱이 직접 부르지 않습니다. 선생님이 각자 쓰는 AI에 프롬프트를 붙여 넣는 방식이라 AI 키가 필요 없습니다.
# 아래 값이 없어도 설계·문서 내려받기는 됩니다. 로그인·저장·관리자 모드를 쓰려면 세 값이 모두 필요합니다.

# MongoDB Atlas 접속 주소 (mongodb+srv://아이디:비밀번호@...). 시험만 할 때는 memory 라고 쓰면 메모리에 저장(재시작 시 사라짐)
MONGODB_URI=
# 사용할 데이터베이스 이름
MONGODB_DB=school_autonomy
# 로그인 비밀키: 32자 이상 아무 문자열 (예: 비밀번호 생성기로 만든 긴 문자열)
AUTH_SECRET=
# 가입하면 승인 없이 바로 관리자가 되는 학교 (정식 명칭, 여러 개는 쉼표로 구분) 예: 광양중동초등학교
ADMIN_SCHOOLS=
